{
  "name": "free-code-deepseek-harness",
  "version": "1.0.0",
  "private": true,
  "description": "Multiplatform desktop GUI shell for deepseek-harness powered by an opencode2api worker pool (DeepSeek-free first, zero-config)",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" build",
    "apply:upstream-patches": "node scripts/apply-upstream-patches.mjs",
    "prepare:upstream": "pnpm apply:upstream-patches && node scripts/link-upstream-workspace-packages.mjs",
    "test": "pnpm prepare:upstream && pnpm --filter @freecode/opencode-adapter build && pnpm -r --workspace-concurrency=1 --filter \"./packages/**\" --filter \"./apps/**\" test",
    "test:contract": "pnpm prepare:upstream && pnpm --filter @freecode/opencode-adapter build && pnpm --filter @freecode/contract-tests test",
    "typecheck": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" typecheck",
    "build:vendor": "pnpm apply:upstream-patches && node scripts/build-vendor-local.mjs",
    "build:shell": "pnpm apply:upstream-patches && pnpm --filter @freecode/shell build",
    "package:runtime": "pnpm apply:upstream-patches && node scripts/run-package-runtime.mjs",
    "package:runtime:release": "pnpm package:runtime && node scripts/package-harness-update.mjs",
    "build:desktop": "pnpm build && pnpm --filter @freecode/shell package:desktop",
    "release:gate": "node scripts/release-gate.mjs",
    "verify:desktop-release-assets": "node scripts/verify-desktop-release-assets.mjs",
    "verify:linux-appimage": "node scripts/verify-linux-appimage.mjs",
    "setup:mcp": "node scripts/setup-mcp-servers.mjs --all",
    "test:mcp": "node --test scripts/mcp-config.test.mjs",
    "test:mcp:offline": "node scripts/mcp-offline-smoke.mjs",
    "verify:upstream-patches": "node scripts/verify-upstream-patch-stack.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.6.3",
    "unrun": "^0.3.1",
    "vitest": "^2.1.8"
  }
}
