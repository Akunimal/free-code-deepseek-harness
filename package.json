{
  "name": "free-code-deepseek-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Multiplatform desktop GUI shell for deepseek-harness powered by an opencode2api worker pool (DeepSeek-free first, zero-config)",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "pnpm -r --filter \"./packages/**\" test",
    "test:contract": "pnpm --filter @freecode/contract-tests test",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
