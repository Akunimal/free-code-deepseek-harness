+func TestMapPublicToFreeModelFallsBackWhenCatalogUnavailable(t *testing.T) {
+	oldModelsCache := modelsCache
+	oldGoModelsCache := goModelsCache
+	oldModelsLoaded := modelsLoaded
+	modelMu.Lock()
+	modelsCache = nil
+	goModelsCache = nil
+	modelsLoaded = false
+	modelMu.Unlock()
+	t.Cleanup(func() {
+		modelMu.Lock()
+		modelsCache = oldModelsCache
+		goModelsCache = oldGoModelsCache
+		modelsLoaded = oldModelsLoaded
+		modelMu.Unlock()
+	})
+
+	public := UpstreamAuth{Mode: AuthRoutePublic}
+	if got := mapPublicToFreeModel(public, "x-preview-f"); got != "x-preview-f-free" {
+		t.Fatalf("mapPublicToFreeModel() = %q, want x-preview-f-free", got)
+	}
+	if got := mapPublicToFreeModel(public, "x-preview-f-free"); got != "x-preview-f-free" {
+		t.Fatalf("free model was changed to %q", got)
+	}
+}
