+    });
+    const color = cssColor();
+    ctx.textBaseline = "middle";
+    ctx.font = "12px ui-monospace, SFMono-Regular, Consolas, monospace";
+    for (const star of stars) {
+      star.phase += star.speed;
+      star.y += 0.08;
