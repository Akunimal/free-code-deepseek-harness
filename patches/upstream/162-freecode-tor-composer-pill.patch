+/* Tor route pill: first seat of the composer leading row. Green glow while
+   Tor carries failover traffic, dimmed on the direct-only route. */
+.on,
+.off {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  border-radius: 999px;
+  padding: 5px 12px;
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  cursor: pointer;
+}
+.on {
+  color: #bbf7d0;
+  background: #052e16;
+  border: 1px solid #22c55e;
+  box-shadow: 0 0 12px rgba(34, 197, 94, 0.75);
+}
+.off {
+  color: #9da4b3;
+  background: transparent;
+  border: 1px solid #2a2f3a;
+}
+.off:disabled,
+.on:disabled {
+  opacity: 0.55;
+  cursor: default;
+}
+.dot {
+  width: 7px;
+  height: 7px;
+  border-radius: 999px;
+  background: currentColor;
+}
