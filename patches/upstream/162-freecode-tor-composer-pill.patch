+/* Tor route indicator: bare token, no container. Electric-blue breathing
+   glow while Tor carries failover traffic, flat gray on the direct-only
+   route. */
+.on,
+.off {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  background: transparent; border: none;
+  padding: 5px 8px;
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  cursor: pointer;
+}
+.on {
+  color: #00bfff;
+  background: transparent; border: none;
+  text-shadow: 0 0 10px rgba(0, 191, 255, 0.9);
+  animation: tor-breathe 2.6s ease-in-out infinite;
+}
+.off {
+  color: #9da4b3;
+  background: transparent; border: none;
+}
+.off:disabled,
+.on:disabled {
+  opacity: 0.55;
+  cursor: default;
+}
+.dot {
+  width: 7px;
+  height: 7px;
+  border-radius: 999px;
+  background: currentColor;
+}
+@keyframes tor-breathe {
+  0%, 100% { opacity: 1; }
+  50% { opacity: 0.65; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .on {
+    animation: none;
+  }
+}
