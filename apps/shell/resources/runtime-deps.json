{
  "$schema": "./runtime-deps.schema.json",
  "version": "1",
  "upstream": {
    "source": "deepseek-ai/deepseek-harness",
    "version": "0.1.3-alpha.1",
    "commit": "99f6f02fecdb7dff40c3fbc9470f5907c29f74ca"
  },
  "payloadDir": "resources/freecode",
  "dependencies": [
    {
      "id": "opencode2api",
      "name": "opencode2api",
      "version": "1.4.0",
      "arch": "win-x64",
      "source": "jasonxu114514/opencode2api",
      "license": "GPL-3.0-or-later",
      "sha256": "e16e2cf2fa1155b543a5c4f88c475dddf1ea552021e696046f46848c5e547e2d",
      "path": "opencode2api/opencode2api-win-x64.exe",
      "launch": {
        "type": "exec",
        "args": [],
        "cwd": "$DSH_HOME"
      },
      "network": false,
      "required": true
    },
    {
      "id": "tor",
      "name": "Tor Expert Bundle",
      "version": "13.5.7",
      "arch": "win-x64",
      "source": "torproject.org/tor-expert-bundle",
      "license": "BSD-3-Clause",
      "sha256": "6b866c187a0dee2fb751a8990d50dc1ed83f68e025720081e4d8e27097067dc8",
      "path": "tor/tor.exe",
      "launch": {
        "type": "exec",
        "args": [
          "-f",
          "$DSH_HOME/tor/torrc"
        ],
        "cwd": "$DSH_HOME/tor"
      },
      "network": false,
      "required": true
    },
    {
      "id": "dsh-cli",
      "name": "dsh CLI",
      "version": "0.2.1-alpha.1",
      "arch": "any",
      "source": "deepseek-ai/deepseek-harness",
      "license": "MIT",
      "sha256": "1a03dee18683483ff6a1b27b2a1e650230da6bcca9a0f55f7d81b3308c3f307f",
      "path": "dsh/apps/cli/lib/bin.js",
      "launch": {
        "type": "node",
        "args": [],
        "cwd": "$DSH_HOME"
      },
      "network": false,
      "required": true
    },
    {
      "id": "tesseract",
      "name": "Tesseract OCR",
      "version": "5.4.0.20240606",
      "arch": "win-x64",
      "source": "UB-Mannheim/Tesseract-OCR",
      "license": "Apache-2.0",
      "sha256": "babb405f4366b480d02cd8ff2bac8d497170f6c1711ce6f3d5d8bf0fb7fa6ed9",
      "path": "tesseract/tesseract.exe",
      "launch": {
        "type": "exec",
        "args": [
          "$INPUT",
          "stdout",
          "--psm",
          "$PSM",
          "-l",
          "$LANG"
        ],
        "cwd": "$TEMP"
      },
      "network": false,
      "required": false,
      "notes": "Optional OCR; resolves from bundled path first, then system PATH"
    },
    {
      "id": "serena",
      "name": "Serena MCP",
      "version": "1.7.1.dev0",
      "arch": "win-x64",
      "source": "oraios/serena",
      "license": "MIT",
      "sha256": "32e3250b7096c4ad5ee15aa1a54ba149ca4edab7bfc688f62015b9ddecb7c3ed",
      "path": ".uv-tools/serena-agent/Scripts/serena.exe",
      "launch": {
        "type": "exec",
        "args": [
          "start-mcp-server",
          "--context",
          "claude-code"
        ],
        "cwd": "$process.cwd"
      },
      "network": false,
      "required": false,
      "notes": "Pre-cached via uv tool install; offline-safe"
    },
    {
      "id": "free-search",
      "name": "free-search MCP",
      "version": "0.11.0",
      "arch": "win-x64",
      "source": "nickclyde/free-search-mcp",
      "license": "MIT",
      "sha256": "b42c745112ba69e6f1cecd2cc023b0e308d039d80a34642955433163cb7c86d5",
      "path": ".uv-tools/free-search-mcp/Scripts/free-search-mcp.exe",
      "launch": {
        "type": "exec",
        "args": [],
        "cwd": "$process.cwd"
      },
      "network": false,
      "required": false,
      "notes": "Pre-cached via uv tool install; offline-safe"
    },
    {
      "id": "uv-managed",
      "name": "uv (managed)",
      "version": "0.12.10",
      "arch": "win-x64",
      "source": "astral-sh/uv",
      "license": "MIT OR Apache-2.0",
      "sha256": "a8bf95637ba520491de06713d718a55b90f18d127980b9531fd8fc5a8e99dc1d",
      "path": "uv/uv.exe",
      "launch": {
        "type": "exec",
        "args": [
          "tool",
          "run",
          "$TOOL"
        ],
        "cwd": "$process.cwd"
      },
      "network": false,
      "required": false,
      "notes": "Vendored binary; used as fallback for MCP tool execution"
    },
    {
      "id": "uvx-managed",
      "name": "uvx (managed)",
      "version": "0.12.10",
      "arch": "win-x64",
      "source": "astral-sh/uv",
      "license": "MIT OR Apache-2.0",
      "sha256": "be080f5ff377f65f634d59729c02b2fb04f97b1df74d473e27323ff0c697fae8",
      "path": "uv/uvx.exe",
      "launch": {
        "type": "exec",
        "args": [
          "$TOOL"
        ],
        "cwd": "$process.cwd"
      },
      "network": false,
      "required": false,
      "notes": "Vendored uvx binary; used as fallback for MCP tool execution"
    },
    {
      "id": "rtk",
      "name": "RTK",
      "version": "N/A",
      "arch": "win-x64",
      "source": "N/A",
      "license": "N/A",
      "sha256": "N/A",
      "path": "N/A",
      "launch": {
        "type": "exec",
        "args": [
          "$COMMAND"
        ],
        "cwd": "$CWD"
      },
      "network": false,
      "required": false,
      "notes": "Optional; not bundled; resolves from PATH only; code checks rtkInstalled at runtime"
    },
    {
      "id": "caveman",
      "name": "Caveman",
      "version": "N/A",
      "arch": "win-x64",
      "source": "JuliusBrussee/caveman",
      "license": "N/A",
      "sha256": "N/A",
      "path": "N/A",
      "launch": {
        "type": "exec",
        "args": [
          "$COMMAND"
        ],
        "cwd": "$CWD"
      },
      "network": false,
      "required": false,
      "notes": "Optional; not bundled; resolves from PATH only; code checks cavemanInstalled at runtime"
    },
    {
      "id": "gentle-ai",
      "name": "Gentle AI",
      "version": "2.6.0",
      "arch": "win-x64",
      "source": "gentle-ai",
      "license": "N/A",
      "sha256": "N/A",
      "path": "gentle-ai/gentle-ai.exe",
      "launch": {
        "type": "exec",
        "args": [
          "$COMMAND"
        ],
        "cwd": "$DSH_HOME"
      },
      "network": false,
      "required": false,
      "notes": "Optional; bundled when approved else PATH-only; resolver prefers resources/gentle-ai/gentle-ai.exe then PATH; caveman/RTK extras PATH-only (size gate)"
    }
  ]
}
