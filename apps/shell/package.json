{
  "name": "@freecode/shell",
  "version": "0.9.3",
  "private": true,
  "description": "Electron main + preload for the free-code-deepseek-harness desktop shell",
  "type": "module",
  "main": "./dist/src/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node --input-type=module -e \"import{buildSync}from'esbuild';buildSync({entryPoints:['dist/src/preload/index.js'],bundle:true,platform:'node',format:'cjs',outfile:'dist/src/preload/index.js',allowOverwrite:true,external:['electron']})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "dev": "pnpm build && electron .",
    "package:runtime": "node ../../scripts/run-package-runtime.mjs",
    "prepackage:verify": "node ../../scripts/verify-nsis-hooks.mjs && node ../../scripts/verify-vendor-bundles-fresh.mjs && node ../../scripts/verify-runtime-manifest.mjs resources/freecode/runtime-manifest.json && node ../../scripts/verify-process-launch-inventory.mjs && node ../../scripts/verify-headless-runtime.mjs resources/freecode/dsh && node ../../scripts/verify-dsh-node-engine.mjs && node ../../scripts/verify-native-abi.mjs",
    "smoke:nsis": "node ../../scripts/verify-nsis-install-layout.mjs",
    "smoke:nsis:upgrade": "node ../../scripts/verify-nsis-upgrade.mjs",
    "package": "pnpm package:desktop",
    "package:desktop": "pnpm prepackage:verify && pnpm build && node ../../scripts/package-desktop.mjs"
  },
  "dependencies": {
    "@freecode/opencode-adapter": "workspace:*",
    "@freecode/shared-types": "workspace:*",
    "electron-updater": "^6.3.9",
    "js-yaml": "^4.1.0",
    "pino": "^9.6.0",
    "semver": "^7.8.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "electron": "44.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "vitest": "^2.1.9"
  }
}
