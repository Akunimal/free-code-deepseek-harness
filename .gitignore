# Dependencies
node_modules/
apps/shell/omniroute-runtime/build/
apps/shell/omniroute-runtime/runtime-manifest.json
apps/shell/resources/freecode/omniroute-runtime.json
.pnpm-store/

# Build output
dist/
out/
*.tsbuildinfo
__pycache__/
*.py[cod]

# Electron / electron-builder
apps/shell/resources/opencode2api/
apps/shell/resources/dsh-cli/
apps/shell/resources/dsh-web/
# Generated staging and runtime payloads stay out of git. The Windows headless
# helper is committed so a fresh clone needs no Go toolchain.
apps/shell/resources/freecode/*
!apps/shell/resources/freecode/.gitkeep
!apps/shell/resources/freecode/headless-host.exe
!apps/shell/resources/freecode/headless-host.json
apps/shell/release/
apps/shell/release-*/
# Local release staging; upload these assets but do not commit binaries.
release-assets-v0.5.0/
graphify-out/cache/
# Local dated Graphify backups; canonical graph outputs stay tracked.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
# Per-package Graphify runs and temporary graph workspaces are local only;
# only the repository-root graph is canonical.
*/**/graphify-out/
.tmp-graphify*/
*.exe
!native/**/build/
# Pinned FreeLLMpool gateway, committed so a fresh clone needs no PyInstaller build.
# Release setup and portable executables stay ignored.
!apps/shell/resources/phoenix/freellmpool-win-x64.exe
!apps/shell/resources/freecode/headless-host.exe

# Native addon builds
apps/shell/native/*/build/
apps/shell/native/*/.cache/

# Go
vendor/opencode2api/dist/
vendor/opencode2api/bin/

# Logs
*.log
logs/

# Env / secrets
.env
.env.*
!.env.example
apps/shell/.secret-vault/

# Runtime data
userData/
data/

# opencode2api runtime artifacts (written to cwd)
config.json
stats.json
session_*.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
apps/shell/electron-builder.yml.bak

# Test artifacts
coverage/
.nyc_output/

# Agent/tool local state (regenerable, never commit)
.atl/
.a0proj/
